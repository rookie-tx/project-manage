<view class="material-form-page">
  <view class="error-bar" wx:if="{{error}}">
    <text class="error-text">{{error}}</text>
  </view>

  <view class="form-container">
    <!-- 物料编码（编辑模式只读） -->
    <view class="form-item">
      <text class="form-label">物料编码 <text class="required">*</text></text>
      <input wx:if="{{!isEdit}}" class="form-input" placeholder="请输入物料编码" value="{{form.code}}" data-field="code" bindinput="onInput" />
      <text wx:else class="form-static">{{form.code}}</text>
    </view>

    <!-- 物料名称 -->
    <view class="form-item">
      <text class="form-label">物料名称 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入物料名称" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <!-- 规格 -->
    <view class="form-item">
      <text class="form-label">规格型号 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入规格型号" value="{{form.spec}}" data-field="spec" bindinput="onInput" />
    </view>

    <!-- 单位 -->
    <view class="form-item">
      <text class="form-label">单位 <text class="required">*</text></text>
      <picker mode="selector" range="{{unitNames}}" value="{{selectedUnitIdx}}" bindchange="onUnitChange">
        <view class="form-picker {{selectedUnitIdx === -1 ? 'picker-placeholder' : ''}}">
          <text>{{selectedUnitIdx === -1 ? '请选择单位' : unitNames[selectedUnitIdx]}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 提交 -->
    <view class="submit-bar">
      <button class="btn-submit" loading="{{submitting}}" bindtap="handleSubmit">{{isEdit ? '保存修改' : '创建物料'}}</button>
    </view>
  </view>
</view>
