.material-list-page {
  min-height: 100vh;
  background: #f3f4f6;
  padding-bottom: 40rpx;
}

.top-bar {
  padding: 20rpx 24rpx;
}

.btn-create {
  background: #6366f1;
  color: #fff;
  font-size: 28rpx;
  border-radius: 10rpx;
  padding: 16rpx 0;
  text-align: center;
}

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 0;
}

.state-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.card-list {
  padding: 0 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.card-body {
  padding: 24rpx;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-row + .card-row {
  margin-top: 12rpx;
}

.card-code {
  font-size: 24rpx;
  color: #9ca3af;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.card-spec,
.card-unit {
  font-size: 26rpx;
  color: #6b7280;
}

.card-actions {
  display: flex;
  border-top: 1rpx solid #f3f4f6;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #6366f1;
}

.action-btn.danger {
  color: #dc2626;
  border-left: 1rpx solid #f3f4f6;
}
