<view class="waste-list-page">
  <!-- 顶部 -->
  <view class="page-header">
    <text class="header-title">废渣管理</text>
    <text class="header-action" wx:if="{{canCreate}}" bindtap="handleCreate">+ 新建</text>
  </view>

  <!-- 筛选区 -->
  <view class="filter-bar">
    <scroll-view scroll-x class="filter-scroll">
      <view class="filter-chips">
        <picker mode="selector" range="{{projectNames}}" value="{{selectedProjectIdx}}" bindchange="onProjectChange">
          <view class="chip {{selectedProjectIdx > 0 ? 'chip-active' : ''}}">
            <text>{{projectNames[selectedProjectIdx]}}</text>
            <text class="chip-arrow">▾</text>
          </view>
        </picker>
        <input class="chip chip-input-real {{wasteType ? 'chip-active' : ''}}" placeholder="废渣种类" value="{{wasteType}}" bindinput="onWasteTypeInput" bindconfirm="onWasteTypeSearch" />
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="chip {{startDate ? 'chip-active' : ''}}">
            <text>{{startDate || '开始日期'}}</text>
          </view>
        </picker>
        <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
          <view class="chip {{endDate ? 'chip-active' : ''}}">
            <text>{{endDate || '结束日期'}}</text>
          </view>
        </picker>
        <view class="chip chip-clear" wx:if="{{selectedProjectIdx > 0 || wasteType || startDate || endDate}}" bindtap="clearFilters">
          <text class="clear-text">✕ 清除</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && records.length === 0}}" class="state-box">
    <text class="state-text">加载中...</text>
  </view>

  <!-- 空 -->
  <view wx:elif="{{records.length === 0}}" class="state-box">
    <text class="state-icon">📷</text>
    <text class="state-text">暂无废渣运出记录</text>
  </view>

  <!-- 列表 -->
  <view wx:else class="records-list">
    <view class="record-card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="handleRecordTap">
      <view class="card-strip"></view>
      <view class="card-body">
        <view class="card-top">
          <text class="card-project">{{item.projectName || '未知项目'}}</text>
          <text class="card-date">{{item.removalDateStr}}</text>
        </view>
        <view class="card-mid">
          <view class="card-type-tag">{{item.wasteType}}</view>
          <text class="card-quantity">{{item.quantityStr}}</text>
        </view>
        <view class="card-bottom">
          <text class="card-meta" wx:if="{{item.vehiclePlate}}">🚛 {{item.vehiclePlate}}</text>
          <text class="card-meta" wx:if="{{item.driverName}}">👤 {{item.driverName}}</text>
          <text class="card-arrow">查看详情 ›</text>
        </view>
      </view>
    </view>

    <view class="load-more">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{!hasMore}}">— 没有更多了 —</text>
    </view>
  </view>
</view>
