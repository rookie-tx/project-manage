<view class="waste-detail-page">
  <view wx:if="{{loading}}" class="state-box">
    <text class="state-text">加载中...</text>
  </view>

  <view wx:elif="{{!record}}" class="state-box">
    <text class="state-icon">📋</text>
    <text class="state-text">记录不存在</text>
    <view class="btn-back" bindtap="navigateBack"><text>返回列表</text></view>
  </view>

  <view wx:else>
    <!-- 废渣信息 -->
    <view class="detail-card">
      <view class="card-head">
        <view class="head-icon">📷</view>
        <view class="head-info">
          <text class="head-title">{{record.wasteType}}</text>
          <text class="head-sub">{{record.projectName || '未知项目'}}</text>
        </view>
        <text class="head-qty">{{quantityStr}}</text>
      </view>
      <view class="divider"></view>
      <view class="detail-grid">
        <view class="grid-item">
          <text class="grid-label">运出日期</text>
          <text class="grid-value">{{removalDateStr}}</text>
        </view>
        <view class="grid-item">
          <text class="grid-label">废渣种类</text>
          <text class="grid-value tag">{{record.wasteType}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.vehiclePlate}}">
          <text class="grid-label">车牌号</text>
          <text class="grid-value">{{record.vehiclePlate}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.driverName}}">
          <text class="grid-label">司机姓名</text>
          <text class="grid-value">{{record.driverName}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.destination}}">
          <text class="grid-label">处置去向</text>
          <text class="grid-value">{{record.destination}}</text>
        </view>
        <view class="grid-item full" wx:if="{{record.remark}}">
          <text class="grid-label">备注</text>
          <text class="grid-value">{{record.remark}}</text>
        </view>
        <view class="grid-item" wx:if="{{createdAtStr}}">
          <text class="grid-label">创建时间</text>
          <text class="grid-value">{{createdAtStr}}</text>
        </view>
      </view>
    </view>

    <!-- 照片 -->
    <view class="detail-card" wx:if="{{photoUrls.length > 0}}">
      <text class="card-title">现场照片</text>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photoUrls}}" wx:key="index" data-index="{{index}}" bindtap="handlePreviewPhoto">
          <image class="photo-thumb" src="{{item}}" mode="aspectFill" />
        </view>
      </view>
    </view>

    <!-- 删除 -->
    <view class="action-bar" wx:if="{{canDelete}}">
      <button class="btn-delete" bindtap="handleDelete">删除记录</button>
    </view>
  </view>
</view>
