.waste-create-page {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 60rpx;
}

/* 顶部栏 */
.page-header {
  padding: 20rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
}

/* 错误提示 */
.error-bar {
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
  border-radius: 8rpx;
}

.error-text {
  font-size: 26rpx;
  color: #ff4d4f;
}

/* 表单容器 */
.form-container {
  padding: 24rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: -8rpx;
  margin-bottom: 12rpx;
}

.form-input {
  background: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  background: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
  min-height: 150rpx;
}

.form-picker {
  background: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-placeholder {
  color: #bbb;
}

.picker-arrow {
  font-size: 36rpx;
  color: #bbb;
}

/* 表单行（两列） */
.form-row {
  display: flex;
  gap: 20rpx;
}

.form-half {
  flex: 1;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.photo-thumb {
  width: 100%;
  height: 100%;
}

.photo-uploading {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
}

.uploading-text {
  color: #fff;
  font-size: 22rpx;
}

.photo-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 0 0 0 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.remove-icon {
  color: #fff;
  font-size: 24rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #fff;
}

.add-icon {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 提交按钮 */
.submit-bar {
  margin-top: 20rpx;
  padding: 0 8rpx;
}

.btn-submit {
  width: 100%;
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  padding: 22rpx 0;
}

.btn-submit[disabled] {
  background: #a0c4ff;
}
