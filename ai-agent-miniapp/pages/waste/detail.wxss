.waste-detail-page { min-height: 100vh; background: #f3f4f6; padding-bottom: 40rpx; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 200rpx 0; }
.state-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.state-text { font-size: 28rpx; color: #9ca3af; margin-bottom: 30rpx; }
.btn-back { padding: 14rpx 36rpx; border: 1rpx solid #6366f1; border-radius: 10rpx; color: #6366f1; font-size: 26rpx; }

/* 详情卡片 */
.detail-card { background: #fff; margin: 16rpx 20rpx; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04); }

.card-head { display: flex; align-items: center; }
.head-icon { width: 80rpx; height: 80rpx; border-radius: 20rpx; background: #eef2ff; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-right: 20rpx; }
.head-info { flex: 1; }
.head-title { display: block; font-size: 32rpx; font-weight: 700; color: #1f2937; }
.head-sub { display: block; font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }
.head-qty { font-size: 36rpx; font-weight: 800; color: #6366f1; }

.divider { height: 1rpx; background: #f3f4f6; margin: 22rpx 0; }

.detail-grid { display: flex; flex-wrap: wrap; }
.grid-item { width: 50%; padding: 12rpx 0; }
.grid-item.full { width: 100%; }
.grid-label { display: block; font-size: 22rpx; color: #9ca3af; margin-bottom: 4rpx; }
.grid-value { font-size: 26rpx; color: #1f2937; }
.grid-value.tag { display: inline-block; background: #eef2ff; color: #6366f1; padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 24rpx; }

.card-title { font-size: 28rpx; font-weight: 600; color: #1f2937; margin-bottom: 18rpx; }

/* 照片 */
.photo-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.photo-item { width: 210rpx; height: 210rpx; border-radius: 14rpx; overflow: hidden; }
.photo-thumb { width: 100%; height: 100%; }

/* 删除 */
.action-bar { padding: 32rpx 20rpx; }
.btn-delete { width: 100%; background: #fff; color: #ef4444; font-size: 30rpx; font-weight: 500; border: 1px solid #fecaca; border-radius: 16rpx; padding: 22rpx 0; }
