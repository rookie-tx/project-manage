.waste-detail-page {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 40rpx;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 36rpx;
}

.btn-back {
  padding: 16rpx 40rpx;
  border: 1rpx solid #1677ff;
  border-radius: 8rpx;
  color: #1677ff;
  font-size: 28rpx;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #fafafa;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  word-break: break-all;
}

.info-value.tag {
  color: #1677ff;
  background: #e6f4ff;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

/* 备注 */
.remark-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo-thumb {
  width: 100%;
  height: 100%;
}

/* 删除按钮 */
.delete-bar {
  margin: 40rpx 24rpx;
}

.btn-delete {
  width: 100%;
  background: #fff;
  color: #ff4d4f;
  font-size: 30rpx;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
  padding: 22rpx 0;
}
