.waste-list-page {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 20rpx;
}

/* 顶部栏 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
}

.header-action {
  font-size: 28rpx;
  color: #1677ff;
  padding: 8rpx 16rpx;
}

/* 筛选区 */
.filter-bar {
  padding: 20rpx 24rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  min-width: 140rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.filter-value {
  font-size: 26rpx;
  color: #333;
}

.filter-placeholder {
  color: #bbb;
}

.filter-input {
  font-size: 26rpx;
  width: 180rpx;
}

.filter-row {
  display: inline-flex;
  align-items: center;
}

.filter-date {
  min-width: 160rpx;
}

.filter-sep {
  margin-right: 16rpx;
  color: #999;
  font-size: 24rpx;
}

.filter-clear {
  display: inline-block;
  padding: 12rpx 20rpx;
}

.clear-text {
  font-size: 24rpx;
  color: #ff4d4f;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 记录列表 */
.records-list {
  padding: 0 24rpx;
}

.record-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-project {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.card-date {
  font-size: 24rpx;
  color: #999;
}

.card-mid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-type {
  font-size: 28rpx;
  color: #1677ff;
  background: #e6f4ff;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.card-quantity {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.card-bottom {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.card-vehicle, .card-driver {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.card-detail-link {
  font-size: 24rpx;
  color: #1677ff;
  margin-left: auto;
}

/* 底部加载 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #bbb;
}
