.waste-list-page { min-height: 100vh; background: #f3f4f6; padding-bottom: 20rpx; }

/* 顶部 */
.page-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 28rpx 20rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: #1f2937; }
.header-action { font-size: 28rpx; font-weight: 600; color: #6366f1; padding: 10rpx 24rpx; background: #eef2ff; border-radius: 10rpx; }

/* 筛选 */
.filter-bar { padding: 0 20rpx 12rpx; }
.filter-scroll { white-space: nowrap; }
.filter-chips { display: inline-flex; gap: 12rpx; padding: 4rpx 8rpx; }
.chip {
  display: inline-flex; align-items: center;
  background: #fff; border-radius: 10rpx; padding: 14rpx 22rpx;
  font-size: 26rpx; color: #6b7280; box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.04);
}
.chip-active { color: #6366f1; background: #eef2ff; }
.chip-arrow { font-size: 20rpx; margin-left: 6rpx; color: #9ca3af; }
.chip-input-real { font-size: 26rpx; width: 170rpx; padding-top: 8rpx; padding-bottom: 8rpx; min-height: auto; }
.chip-clear { background: #fef2f2; }
.clear-text { font-size: 24rpx; color: #ef4444; }

/* 状态 */
.state-box { display: flex; flex-direction: column; align-items: center; padding: 180rpx 0; }
.state-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.state-text { font-size: 28rpx; color: #9ca3af; }

/* 列表 */
.records-list { padding: 0 20rpx; }
.record-card {
  display: flex; background: #fff; border-radius: 16rpx;
  margin-bottom: 16rpx; overflow: hidden;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.card-strip { width: 8rpx; flex-shrink: 0; background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%); }
.card-body { flex: 1; padding: 24rpx 24rpx 24rpx 20rpx; }
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.card-project { font-size: 30rpx; font-weight: 600; color: #1f2937; }
.card-date { font-size: 22rpx; color: #9ca3af; }
.card-mid { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.card-type-tag { font-size: 24rpx; color: #6366f1; background: #eef2ff; padding: 4rpx 16rpx; border-radius: 6rpx; }
.card-quantity { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.card-bottom { display: flex; align-items: center; gap: 16rpx; }
.card-meta { font-size: 22rpx; color: #6b7280; background: #f3f4f6; padding: 4rpx 12rpx; border-radius: 6rpx; }
.card-arrow { font-size: 24rpx; color: #6366f1; margin-left: auto; }

.load-more { text-align: center; padding: 30rpx 0; font-size: 24rpx; color: #d1d5db; }
