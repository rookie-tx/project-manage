<view class="dashboard-page">
  <!-- 顶部问候 -->
  <view class="greeting-section">
    <view class="greeting-left">
      <text class="greeting-text">{{greetingText}}</text>
      <text class="greeting-user">{{displayName}}</text>
    </view>
    <view class="greeting-avatar" bindtap="handleLogout">
      <text class="avatar-text">{{username[0]}}</text>
    </view>
  </view>

  <!-- 概览卡片（按权限展示） -->
  <view class="overview-row" wx:if="{{showCheckinOverview || showApprovalOverview}}">
    <view class="overview-card overview-blue" wx:if="{{showCheckinOverview}}" bindtap="handleOverviewTap" data-type="checkin">
      <view class="overview-icon-wrap">
        <text class="overview-icon">⏱️</text>
      </view>
      <view class="overview-info">
        <text class="overview-value">考勤打卡</text>
        <text class="overview-label">今日{{checkedIn ? '已打卡' : '未打卡'}}</text>
      </view>
      <text class="overview-arrow">›</text>
    </view>
    <view class="overview-card overview-red" wx:if="{{showApprovalOverview}}" bindtap="handleOverviewTap" data-type="approval">
      <view class="overview-icon-wrap">
        <text class="overview-icon">✅</text>
      </view>
      <view class="overview-info">
        <text class="overview-value">{{approvalCount}} 项待办</text>
        <text class="overview-label">审批任务</text>
      </view>
      <text class="overview-arrow">›</text>
    </view>
  </view>

  <!-- 供应商专属空状态提示 -->
  <view class="section-header" wx:if="{{features.length > 0}}">
    <text class="section-title">功能服务</text>
  </view>

  <view class="feature-grid" wx:if="{{features.length > 0}}">
    <view
      class="feature-card card-active"
      wx:for="{{features}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="handleFeatureTap"
    >
      <view class="card-icon-container" style="background: {{item.color}}">
        <text class="card-icon">{{item.icon}}</text>
      </view>
      <text class="card-name">{{item.name}}</text>
      <text class="card-tip">{{item.tip}}</text>
      <view class="card-badge" wx:if="{{item.badge && approvalCount > 0}}">
        <text class="card-badge-text">{{approvalCount > 99 ? '99+' : approvalCount}}</text>
      </view>
    </view>
  </view>

  <!-- 无可用模块时的提示 -->
  <view class="empty-features" wx:if="{{features.length === 0}}">
    <text class="empty-icon">🔒</text>
    <text class="empty-title">暂无可用功能</text>
    <text class="empty-desc">您的账号尚未分配业务权限，请联系管理员</text>
  </view>

  <!-- 版本信息 -->
  <view class="footer">
    <text class="footer-text">智能管理平台 v1.0</text>
  </view>
</view>
