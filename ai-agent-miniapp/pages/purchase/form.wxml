<view class="pr-form-page">
  <view class="error-bar" wx:if="{{error}}">
    <text class="error-text">{{error}}</text>
  </view>

  <view class="form-container">
    <!-- 项目 -->
    <view class="form-item">
      <text class="form-label">所属项目 <text class="required">*</text></text>
      <picker mode="selector" range="{{projectNames}}" value="{{selectedProjectIdx}}" bindchange="onProjectChange">
        <view class="form-picker {{selectedProjectIdx === -1 ? 'picker-placeholder' : ''}}">
          <text>{{selectedProjectIdx === -1 ? '请选择项目' : projectNames[selectedProjectIdx]}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 物料名称 -->
    <view class="form-item">
      <text class="form-label">物料名称 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入物料名称" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <!-- 规格 + 品牌 -->
    <view class="form-row">
      <view class="form-item form-half">
        <text class="form-label">规格</text>
        <input class="form-input" placeholder="如：φ25 螺纹钢" value="{{form.specification}}" data-field="specification" bindinput="onInput" />
      </view>
      <view class="form-item form-half">
        <text class="form-label">品牌</text>
        <input class="form-input" placeholder="如：鞍钢" value="{{form.brand}}" data-field="brand" bindinput="onInput" />
      </view>
    </view>

    <!-- 数量 + 单位 -->
    <view class="form-row">
      <view class="form-item form-half">
        <text class="form-label">数量 <text class="required">*</text></text>
        <input class="form-input" type="digit" placeholder="数量" value="{{form.quantity}}" data-field="quantity" bindinput="onInput" />
      </view>
      <view class="form-item form-half">
        <text class="form-label">单位 <text class="required">*</text></text>
        <picker mode="selector" range="{{unitNames}}" value="{{selectedUnitIdx}}" bindchange="onUnitChange">
          <view class="form-picker {{selectedUnitIdx === -1 ? 'picker-placeholder' : ''}}">
            <text>{{selectedUnitIdx === -1 ? '选择单位' : unitNames[selectedUnitIdx]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 到场时间 -->
    <view class="form-item">
      <text class="form-label">到场时间 <text class="required">*</text></text>
      <picker mode="date" value="{{form.arrivalDate}}" bindchange="onDateChange">
        <view class="form-picker {{form.arrivalDate ? '' : 'picker-placeholder'}}">
          <text>{{form.arrivalDate || '选择到场时间'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="备注信息（可选）" value="{{form.remark}}" data-field="remark" bindinput="onInput" maxlength="500" auto-height />
    </view>

    <!-- 提交 -->
    <view class="submit-bar">
      <button class="btn-submit" loading="{{submitting}}" bindtap="handleSubmit">{{isEdit ? '保存修改' : '提交申请'}}</button>
    </view>
  </view>
</view>
