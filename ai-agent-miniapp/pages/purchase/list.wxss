.pr-list-page { min-height: 100vh; background: #f0f2f5; padding-bottom: 20rpx; }
.page-header { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 32rpx; background: #fff; border-bottom: 1rpx solid #e8e8e8; }
.header-title { font-size: 34rpx; font-weight: 600; }
.header-action { font-size: 28rpx; color: #1677ff; padding: 8rpx 16rpx; }
.filter-bar { padding: 20rpx 24rpx; background: #fff; margin-bottom: 16rpx; }
.filter-item { display: inline-flex; align-items: center; background: #f5f5f5; border-radius: 8rpx; padding: 12rpx 20rpx; }
.filter-label { font-size: 24rpx; color: #999; margin-right: 8rpx; }
.filter-value { font-size: 26rpx; color: #333; }
.filter-placeholder { color: #bbb; }
.loading-container { display: flex; justify-content: center; padding: 200rpx 0; }
.loading-text { font-size: 28rpx; color: #999; }
.empty-container { display: flex; flex-direction: column; align-items: center; padding: 200rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; }

.items-list { padding: 0 24rpx; }
.pr-card { background: #fff; border-radius: 12rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); overflow: hidden; }
.card-main { padding: 24rpx 24rpx 12rpx; }
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.card-name { font-size: 30rpx; font-weight: 500; color: #333; flex: 1; }
.card-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 4rpx; }
.status-0 { color: #fa8c16; background: #fff7e6; }
.status-1 { color: #1677ff; background: #e6f4ff; }
.status-2 { color: #52c41a; background: #f6ffed; }
.status-3 { color: #ff4d4f; background: #fff2f0; }
.status-4 { color: #999; background: #f5f5f5; }
.card-mid { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.card-project { font-size: 24rpx; color: #666; }
.card-qty { font-size: 26rpx; color: #333; font-weight: 500; }
.card-bottom { display: flex; justify-content: space-between; align-items: center; }
.card-date { font-size: 22rpx; color: #999; }
.card-node { font-size: 22rpx; color: #1677ff; }

.card-actions { display: flex; border-top: 1rpx solid #f0f0f0; padding: 16rpx 24rpx; gap: 24rpx; }
.action-btn { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 4rpx; }
.btn-submit { color: #fff; background: #1677ff; }
.btn-edit { color: #1677ff; border: 1rpx solid #1677ff; }
.btn-delete { color: #ff4d4f; border: 1rpx solid #ff4d4f; }
.btn-view { color: #1677ff; border: 1rpx solid #1677ff; }

.load-more { text-align: center; padding: 30rpx 0; font-size: 24rpx; color: #bbb; }
