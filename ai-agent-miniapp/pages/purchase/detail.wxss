.pr-detail-page { min-height: 100vh; background: #f3f4f6; padding-bottom: 40rpx; }
.state-box { display: flex; justify-content: center; padding: 200rpx 0; }
.state-text { font-size: 28rpx; color: #9ca3af; }

/* 卡片 */
.detail-card { background: #fff; margin: 16rpx 20rpx; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04); }

/* 头部 */
.card-head { display: flex; align-items: center; }
.head-icon { width: 80rpx; height: 80rpx; border-radius: 20rpx; background: #eef2ff; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-right: 20rpx; }
.head-info { flex: 1; }
.head-title { display: block; font-size: 32rpx; font-weight: 700; color: #1f2937; }
.head-sub { display: block; font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }
.head-status { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 8rpx; }
.status-0 { color: #d97706; background: #fef3c7; }
.status-1 { color: #2563eb; background: #dbeafe; }
.status-2 { color: #16a34a; background: #dcfce7; }
.status-3 { color: #dc2626; background: #fecaca; }

.divider { height: 1rpx; background: #f3f4f6; margin: 22rpx 0; }

/* 信息网格 */
.detail-grid { display: flex; flex-wrap: wrap; }
.grid-item { width: 50%; padding: 12rpx 0; }
.grid-item.full { width: 100%; }
.grid-label { display: block; font-size: 22rpx; color: #9ca3af; margin-bottom: 4rpx; }
.grid-value { font-size: 26rpx; color: #1f2937; }
.grid-value.tag-node { display: inline-block; background: #eef2ff; color: #6366f1; padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 24rpx; }

.card-title { font-size: 28rpx; font-weight: 600; color: #1f2937; margin-bottom: 20rpx; }

/* 提交审批 */
.form-item { margin-bottom: 20rpx; }
.form-label { display: block; font-size: 26rpx; color: #1f2937; margin-bottom: 8rpx; }
.form-picker { background: #f3f4f6; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; display: flex; justify-content: space-between; align-items: center; color: #1f2937; }
.picker-placeholder { color: #9ca3af; }
.picker-arrow { font-size: 32rpx; color: #d1d5db; }
.btn-submit-approval { width: 100%; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff; font-size: 28rpx; font-weight: 600; border-radius: 14rpx; padding: 20rpx 0; margin-top: 8rpx; border: none; box-shadow: 0 4rpx 14rpx rgba(99,102,241,0.25); }

/* 操作 */
.action-bar { display: flex; gap: 20rpx; padding: 0 20rpx 16rpx; }
.btn-edit, .btn-delete { flex: 1; font-size: 28rpx; font-weight: 500; border-radius: 14rpx; padding: 20rpx 0; border: none; }
.btn-edit { background: #fff; color: #6366f1; border: 1px solid #c7d2fe; }
.btn-delete { background: #fff; color: #ef4444; border: 1px solid #fecaca; }

/* 历史 */
.history-placeholder { text-align: center; padding: 30rpx 0; }
.placeholder-text { font-size: 26rpx; color: #9ca3af; }
.timeline { padding-left: 20rpx; }
.timeline-item { display: flex; position: relative; padding-bottom: 24rpx; }
.timeline-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 10rpx; margin-right: 20rpx; flex-shrink: 0; position: relative; z-index: 1; }
.dot-approve { background: #16a34a; }
.dot-reject { background: #dc2626; }
.timeline-line { position: absolute; left: 7rpx; top: 30rpx; width: 2rpx; height: calc(100% - 6rpx); background: #e5e7eb; z-index: 0; }
.timeline-content { flex: 1; min-width: 0; }
.timeline-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.timeline-node { font-size: 28rpx; font-weight: 500; color: #1f2937; }
.timeline-result { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 6rpx; }
.text-approve { color: #16a34a; background: #dcfce7; }
.text-reject { color: #dc2626; background: #fecaca; }
.timeline-assignee, .timeline-comment { font-size: 24rpx; color: #6b7280; display: block; margin-bottom: 4rpx; }
.timeline-time { font-size: 22rpx; color: #9ca3af; display: block; }
