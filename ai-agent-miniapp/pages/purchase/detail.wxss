.pr-detail-page { min-height: 100vh; background: #f0f2f5; padding-bottom: 40rpx; }
.loading-container { display: flex; justify-content: center; padding: 200rpx 0; }
.loading-text { font-size: 28rpx; color: #999; }
.empty-container { display: flex; justify-content: center; padding: 200rpx 0; }
.empty-text { font-size: 28rpx; color: #999; }

.info-card, .submit-card, .history-card { background: #fff; margin: 16rpx 24rpx; border-radius: 12rpx; padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #fafafa; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 26rpx; color: #999; flex-shrink: 0; margin-right: 24rpx; }
.info-value { font-size: 26rpx; color: #333; text-align: right; word-break: break-all; }
.info-value.tag { padding: 4rpx 16rpx; border-radius: 6rpx; }
.status-0 { color: #fa8c16; background: #fff7e6; }
.status-1 { color: #1677ff; background: #e6f4ff; }
.status-2 { color: #52c41a; background: #f6ffed; }
.status-3 { color: #ff4d4f; background: #fff2f0; }

/* 提交审批 */
.submit-card .form-item { margin-bottom: 20rpx; }
.submit-card .form-label { display: block; font-size: 26rpx; color: #333; margin-bottom: 10rpx; }
.form-picker { background: #f5f5f5; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 26rpx; display: flex; justify-content: space-between; align-items: center; }
.picker-placeholder { color: #bbb; }
.picker-arrow { font-size: 32rpx; color: #bbb; }
.btn-submit-approval { width: 100%; background: #1677ff; color: #fff; font-size: 28rpx; border-radius: 8rpx; padding: 18rpx 0; margin-top: 10rpx; }

/* 操作按钮 */
.action-bar { display: flex; gap: 24rpx; margin: 16rpx 24rpx; }
.btn-edit, .btn-delete { flex: 1; font-size: 28rpx; border-radius: 8rpx; padding: 18rpx 0; }
.btn-edit { background: #fff; color: #1677ff; border: 1rpx solid #1677ff; }
.btn-delete { background: #fff; color: #ff4d4f; border: 1rpx solid #ff4d4f; }

/* 时间线 */
.history-loading, .history-empty { text-align: center; padding: 30rpx 0; }
.timeline { padding-left: 20rpx; }
.timeline-item { display: flex; position: relative; padding-bottom: 24rpx; }
.timeline-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 10rpx; margin-right: 20rpx; flex-shrink: 0; position: relative; z-index: 1; }
.dot-approve { background: #52c41a; }
.dot-reject { background: #ff4d4f; }
.timeline-line { position: absolute; left: 7rpx; top: 30rpx; width: 2rpx; height: calc(100% - 6rpx); background: #e8e8e8; z-index: 0; }
.timeline-content { flex: 1; min-width: 0; }
.timeline-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.timeline-node { font-size: 28rpx; font-weight: 500; color: #333; }
.timeline-result { font-size: 24rpx; padding: 2rpx 12rpx; border-radius: 4rpx; }
.text-approve { color: #52c41a; background: #f6ffed; }
.text-reject { color: #ff4d4f; background: #fff2f0; }
.timeline-assignee, .timeline-comment { font-size: 24rpx; color: #666; display: block; margin-bottom: 4rpx; }
.timeline-time { font-size: 22rpx; color: #bbb; display: block; }
