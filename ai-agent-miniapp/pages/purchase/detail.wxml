<view class="pr-detail-page">
  <view wx:if="{{loading}}" class="state-box">
    <text class="state-text">加载中...</text>
  </view>

  <view wx:elif="{{!record}}" class="state-box">
    <text class="state-text">记录不存在</text>
  </view>

  <view wx:else>
    <!-- 头部 -->
    <view class="detail-card">
      <view class="card-head">
        <view class="head-icon">📦</view>
        <view class="head-info">
          <text class="head-title">{{record.name}}</text>
          <text class="head-sub">{{record.projectName || '未知项目'}}</text>
        </view>
        <view class="head-status status-{{record.statusCode}}">{{statusLabel}}</view>
      </view>
      <view class="divider"></view>
      <view class="detail-grid">
        <view class="grid-item" wx:if="{{record.specification}}">
          <text class="grid-label">规格</text><text class="grid-value">{{record.specification}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.brand}}">
          <text class="grid-label">品牌</text><text class="grid-value">{{record.brand}}</text>
        </view>
        <view class="grid-item">
          <text class="grid-label">数量</text><text class="grid-value">{{quantityStr}}</text>
        </view>
        <view class="grid-item">
          <text class="grid-label">到场时间</text><text class="grid-value">{{arrivalDateStr}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.currentApprovalNode}}">
          <text class="grid-label">当前节点</text><text class="grid-value tag-node">{{record.currentApprovalNode}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.createdByName}}">
          <text class="grid-label">创建人</text><text class="grid-value">{{record.createdByName}}</text>
        </view>
        <view class="grid-item" wx:if="{{createdAtStr}}">
          <text class="grid-label">创建时间</text><text class="grid-value">{{createdAtStr}}</text>
        </view>
        <view class="grid-item full" wx:if="{{record.remark}}">
          <text class="grid-label">备注</text><text class="grid-value">{{record.remark}}</text>
        </view>
      </view>
    </view>

    <!-- 提交审批 -->
    <view class="detail-card" wx:if="{{isPending && canSubmit}}" id="submitArea">
      <text class="card-title">提交审批</text>
      <view class="form-item">
        <text class="form-label">部门经理</text>
        <picker mode="selector" range="{{userNames}}" value="{{deptMgrIdx}}" bindchange="onDeptMgrChange">
          <view class="form-picker {{deptMgrIdx === -1 ? 'picker-placeholder' : ''}}">
            <text>{{deptMgrIdx === -1 ? '请选择部门经理' : userNames[deptMgrIdx]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">财务审批</text>
        <picker mode="selector" range="{{userNames}}" value="{{financeMgrIdx}}" bindchange="onFinanceMgrChange">
          <view class="form-picker {{financeMgrIdx === -1 ? 'picker-placeholder' : ''}}">
            <text>{{financeMgrIdx === -1 ? '请选择财务经理' : userNames[financeMgrIdx]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">总经理</text>
        <picker mode="selector" range="{{userNames}}" value="{{generalMgrIdx}}" bindchange="onGeneralMgrChange">
          <view class="form-picker {{generalMgrIdx === -1 ? 'picker-placeholder' : ''}}">
            <text>{{generalMgrIdx === -1 ? '请选择总经理' : userNames[generalMgrIdx]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <button class="btn-submit-approval" loading="{{submittingApproval}}" bindtap="handleSubmitApproval">确认提交审批</button>
    </view>

    <!-- 操作 -->
    <view class="action-bar" wx:if="{{isPending}}">
      <button class="btn-edit" bindtap="handleEdit">编辑</button>
      <button class="btn-delete" bindtap="handleDelete">删除</button>
    </view>

    <!-- 审批历史 -->
    <view class="detail-card">
      <text class="card-title">审批历史</text>
      <view wx:if="{{historyLoading}}" class="history-placeholder"><text class="placeholder-text">加载中...</text></view>
      <view wx:elif="{{history.length === 0}}" class="history-placeholder"><text class="placeholder-text">暂无审批记录</text></view>
      <view wx:else class="timeline">
        <view class="timeline-item" wx:for="{{history}}" wx:key="index">
          <view class="timeline-dot {{item.result === '通过' ? 'dot-approve' : 'dot-reject'}}"></view>
          <view class="timeline-line" wx:if="{{index < history.length - 1}}"></view>
          <view class="timeline-content">
            <view class="timeline-header">
              <text class="timeline-node">{{item.nodeName || '-'}}</text>
              <text class="timeline-result {{item.result === '通过' ? 'text-approve' : 'text-reject'}}">{{item.result}}</text>
            </view>
            <text class="timeline-assignee">审批人：{{item.assignee || '-'}}</text>
            <text class="timeline-comment" wx:if="{{item.comment}}">意见：{{item.comment}}</text>
            <text class="timeline-time">{{item.time || '-'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
