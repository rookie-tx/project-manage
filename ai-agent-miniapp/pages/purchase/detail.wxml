<view class="pr-detail-page">
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{!record}}" class="empty-container">
    <text class="empty-text">记录不存在</text>
  </view>

  <view wx:else>
    <!-- 基本信息 -->
    <view class="info-card">
      <view class="card-title">{{record.name}}</view>
      <view class="info-row"><text class="info-label">项目</text><text class="info-value">{{record.projectName || '-'}}</text></view>
      <view class="info-row"><text class="info-label">物料名称</text><text class="info-value">{{record.name}}</text></view>
      <view class="info-row" wx:if="{{record.specification}}"><text class="info-label">规格</text><text class="info-value">{{record.specification}}</text></view>
      <view class="info-row" wx:if="{{record.brand}}"><text class="info-label">品牌</text><text class="info-value">{{record.brand}}</text></view>
      <view class="info-row"><text class="info-label">数量</text><text class="info-value">{{quantityStr}}</text></view>
      <view class="info-row"><text class="info-label">到场时间</text><text class="info-value">{{arrivalDateStr}}</text></view>
      <view class="info-row">
        <text class="info-label">状态</text>
        <text class="info-value tag status-{{record.statusCode}}">{{statusLabel}}</text>
      </view>
      <view class="info-row" wx:if="{{record.currentApprovalNode}}">
        <text class="info-label">当前审批节点</text><text class="info-value">{{record.currentApprovalNode}}</text>
      </view>
      <view class="info-row" wx:if="{{record.createdByName}}"><text class="info-label">创建人</text><text class="info-value">{{record.createdByName}}</text></view>
      <view class="info-row" wx:if="{{createdAtStr}}"><text class="info-label">创建时间</text><text class="info-value">{{createdAtStr}}</text></view>
      <view class="info-row" wx:if="{{record.remark}}"><text class="info-label">备注</text><text class="info-value">{{record.remark}}</text></view>
    </view>

    <!-- 提交审批区（仅待提交 + 有权限） -->
    <view class="submit-card" wx:if="{{isPending && canSubmit}}" id="submitArea">
      <view class="card-title">提交审批</view>
      <view class="form-item">
        <text class="form-label">部门经理</text>
        <picker mode="selector" range="{{userNames}}" value="{{deptMgrIdx}}" bindchange="onDeptMgrChange">
          <view class="form-picker {{deptMgrIdx === -1 ? 'picker-placeholder' : ''}}">
            <text>{{deptMgrIdx === -1 ? '请选择部门经理' : userNames[deptMgrIdx]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">财务审批</text>
        <picker mode="selector" range="{{userNames}}" value="{{financeMgrIdx}}" bindchange="onFinanceMgrChange">
          <view class="form-picker {{financeMgrIdx === -1 ? 'picker-placeholder' : ''}}">
            <text>{{financeMgrIdx === -1 ? '请选择财务经理' : userNames[financeMgrIdx]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">总经理</text>
        <picker mode="selector" range="{{userNames}}" value="{{generalMgrIdx}}" bindchange="onGeneralMgrChange">
          <view class="form-picker {{generalMgrIdx === -1 ? 'picker-placeholder' : ''}}">
            <text>{{generalMgrIdx === -1 ? '请选择总经理' : userNames[generalMgrIdx]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <button class="btn-submit-approval" loading="{{submittingApproval}}" bindtap="handleSubmitApproval">确认提交审批</button>
    </view>

    <!-- 操作按钮（仅待提交） -->
    <view class="action-bar" wx:if="{{isPending}}">
      <button class="btn-edit" bindtap="handleEdit">编辑</button>
      <button class="btn-delete" bindtap="handleDelete">删除</button>
    </view>

    <!-- 审批历史时间线 -->
    <view class="history-card">
      <view class="card-title">审批历史</view>
      <view wx:if="{{historyLoading}}" class="history-loading"><text class="loading-text">加载中...</text></view>
      <view wx:elif="{{history.length === 0}}" class="history-empty"><text class="empty-text">暂无审批记录</text></view>
      <view wx:else class="timeline">
        <view class="timeline-item" wx:for="{{history}}" wx:key="index">
          <view class="timeline-dot {{item.result === '通过' ? 'dot-approve' : 'dot-reject'}}"></view>
          <view class="timeline-line" wx:if="{{index < history.length - 1}}"></view>
          <view class="timeline-content">
            <view class="timeline-header">
              <text class="timeline-node">{{item.nodeName || '-'}}</text>
              <text class="timeline-result {{item.result === '通过' ? 'text-approve' : 'text-reject'}}">{{item.result}}</text>
            </view>
            <text class="timeline-assignee">审批人：{{item.assignee || '-'}}</text>
            <text class="timeline-comment" wx:if="{{item.comment}}">意见：{{item.comment}}</text>
            <text class="timeline-time">{{item.time || '-'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
