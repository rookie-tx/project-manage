.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1677ff 0%, #69b1ff 100%);
  padding: 40rpx;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 60rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12);
}

.login-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.login-icon { font-size: 80rpx; margin-bottom: 20rpx; }

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.login-subtitle { font-size: 26rpx; color: #999; }

.wechat-login-btn {
  width: 100%;
  height: 88rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-tip {
  display: block;
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  margin-top: 24rpx;
}

.error-msg {
  background: #fff2f0;
  color: #ff4d4f;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #ffccc7;
}

.bind-form { display: flex; flex-direction: column; }

.form-input {
  height: 88rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.bind-submit-btn {
  width: 100%;
  height: 88rpx;
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.go-back-link {
  display: block;
  text-align: center;
  color: #1677ff;
  font-size: 28rpx;
  margin-top: 32rpx;
}
