.login-page {
  min-height: 100vh;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  padding: 40rpx;
}
.login-card {
  width: 100%; max-width: 600rpx;
  background: #fff; border-radius: 24rpx; padding: 80rpx 56rpx;
  box-shadow: 0 12rpx 48rpx rgba(99,102,241,0.2);
}
.login-logo { display: flex; flex-direction: column; align-items: center; margin-bottom: 60rpx; }
.login-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.login-title { font-size: 40rpx; font-weight: 700; color: #1f2937; margin-bottom: 12rpx; }
.login-subtitle { font-size: 26rpx; color: #9ca3af; }

.wechat-login-btn {
  width: 100%; height: 88rpx; background: #16a34a;
  color: #fff; font-size: 32rpx; font-weight: 600; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(22,163,74,0.25);
}
.login-tip { display: block; text-align: center; color: #9ca3af; font-size: 24rpx; margin-top: 24rpx; }

.error-msg {
  background: #fef2f2; color: #ef4444; font-size: 26rpx;
  padding: 16rpx 24rpx; border-radius: 10rpx; margin-bottom: 28rpx;
  border: 1rpx solid #fecaca;
}

.bind-form { display: flex; flex-direction: column; }
.form-input {
  height: 88rpx; background: #f3f4f6; border-radius: 14rpx;
  padding: 0 24rpx; font-size: 30rpx; color: #1f2937; margin-bottom: 20rpx;
}
.bind-submit-btn {
  width: 100%; height: 88rpx;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #fff; font-size: 32rpx; font-weight: 600; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  margin-top: 12rpx; box-shadow: 0 6rpx 20rpx rgba(99,102,241,0.3);
}
.go-back-link { display: block; text-align: center; color: #6366f1; font-size: 28rpx; margin-top: 32rpx; }
