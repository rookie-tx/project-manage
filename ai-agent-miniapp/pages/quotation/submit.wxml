<view class="submit-form-page">
  <view class="error-bar" wx:if="{{error}}">
    <text class="error-text">{{error}}</text>
  </view>

  <!-- 物料信息卡片 -->
  <view wx:if="{{orderDetail}}" class="info-card">
    <view class="info-title">{{orderDetail.materialName}}</view>
    <view class="info-row">
      <text class="info-label">规格</text>
      <text class="info-value">{{orderDetail.specification}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">数量</text>
      <text class="info-value">{{orderDetail.quantityStr}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">预计到货</text>
      <text class="info-value">{{orderDetail.expectedArrivalDate}}</text>
    </view>
  </view>

  <!-- 报价表单 -->
  <view class="form-container">
    <view class="form-item">
      <text class="form-label">单价（元）</text>
      <input class="form-input" type="digit" placeholder="请输入单价" value="{{form.unitPrice}}" data-field="unitPrice" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">总金额（元）<text class="required">*</text></text>
      <input class="form-input" type="digit" placeholder="请输入总金额" value="{{form.totalAmount}}" data-field="totalAmount" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">预计交货日期</text>
      <picker mode="date" value="{{form.deliveryDate}}" bindchange="onDateChange">
        <view class="form-picker {{form.deliveryDate ? '' : 'picker-placeholder'}}">
          <text>{{form.deliveryDate || '请选择日期'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="备注信息（选填）" value="{{form.remark}}" data-field="remark" bindinput="onInput" maxlength="500" auto-height />
    </view>

    <view class="submit-bar">
      <button class="btn-submit" loading="{{submitting}}" bindtap="handleSubmit">{{hasQuoted ? '更新报价' : '提交报价'}}</button>
    </view>
  </view>
</view>
