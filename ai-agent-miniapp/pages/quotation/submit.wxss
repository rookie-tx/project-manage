.submit-form-page { min-height: 100vh; background: #f3f4f6; padding-bottom: 60rpx; }

.error-bar { margin: 16rpx 20rpx; padding: 16rpx 24rpx; background: #fef2f2; border: 1rpx solid #fecaca; border-radius: 12rpx; }
.error-text { font-size: 26rpx; color: #ef4444; }

/* 物料信息卡片 */
.info-card { background: #eef2ff; margin: 16rpx 20rpx; border-radius: 20rpx; padding: 24rpx 28rpx; }
.info-title { font-size: 30rpx; font-weight: 600; color: #6366f1; margin-bottom: 16rpx; }
.info-row { display: flex; justify-content: space-between; padding: 6rpx 0; }
.info-label { font-size: 26rpx; color: #818cf8; }
.info-value { font-size: 26rpx; color: #4f46e5; }

/* 表单卡片 */
.form-container { background: #fff; margin: 16rpx 20rpx; border-radius: 20rpx; padding: 28rpx 28rpx 8rpx; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04); }
.form-item { margin-bottom: 28rpx; }
.form-label { display: block; font-size: 28rpx; font-weight: 500; color: #1f2937; margin-bottom: 10rpx; }
.required { color: #ef4444; }

.form-input { background: #f3f4f6; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; color: #1f2937; }
.form-textarea { background: #f3f4f6; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; color: #1f2937; width: 100%; min-height: 140rpx; box-sizing: border-box; }
.form-picker { background: #f3f4f6; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; color: #1f2937; display: flex; justify-content: space-between; align-items: center; }
.picker-placeholder { color: #9ca3af; }
.picker-arrow { font-size: 36rpx; color: #d1d5db; }

.submit-bar { padding: 24rpx 0; }
.btn-submit { width: 100%; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff; font-size: 32rpx; font-weight: 600; border-radius: 16rpx; padding: 24rpx 0; border: none; box-shadow: 0 6rpx 20rpx rgba(99,102,241,0.3); }
