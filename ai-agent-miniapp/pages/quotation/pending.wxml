<view class="container">
  <view class="header">
    <text class="title">待报价物料</text>
    <text class="tip">选择物料进行报价</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && items.length === 0}}" class="loading-wrap">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && items.length === 0}}" class="empty-wrap">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无可报价的物料</text>
  </view>

  <!-- 列表 -->
  <view wx:else class="list">
    <view wx:for="{{items}}" wx:key="id" class="card" bindtap="handleQuote" data-id="{{item.id}}">
      <view class="card-header">
        <text class="material-name">{{item.materialName}}</text>
        <text class="status-tag">{{item.statusLabel}}</text>
      </view>
      <view class="card-body">
        <view class="row">
          <text class="label">规格</text>
          <text class="value">{{item.specification || '-'}}</text>
        </view>
        <view class="row">
          <text class="label">数量</text>
          <text class="value">{{item.quantityStr}}</text>
        </view>
        <view class="row">
          <text class="label">预计到货</text>
          <text class="value">{{item.expectedArrivalDate}}</text>
        </view>
      </view>
      <view class="card-footer">
        <text class="action-btn">去报价 →</text>
      </view>
    </view>
  </view>

  <!-- 底部加载提示 -->
  <view wx:if="{{loading && items.length > 0}}" class="loading-more">加载更多...</view>
  <view wx:elif="{{!hasMore && items.length > 0}}" class="no-more">没有更多了</view>
</view>
