.container { padding: 16px; background: #f5f5f5; min-height: 100vh; }
.loading-wrap { text-align: center; padding: 80px 0; color: #999; }

.status-bar { text-align: center; padding: 16px 0; }
.status-tag { font-size: 14px; padding: 4px 16px; border-radius: 16px; background: #e6f7ff; color: #1890ff; }
.status-tag.selected { background: #f6ffed; color: #52c41a; }

.section { background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 12px; }
.section-title { font-size: 15px; font-weight: 600; color: #1a1a1a; display: block; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #f0f0f0; }
.info-row { display: flex; justify-content: space-between; padding: 6px 0; }
.label { font-size: 14px; color: #999; }
.value { font-size: 14px; color: #333; }
.price { font-weight: 600; color: #cf1322; font-size: 16px; }
