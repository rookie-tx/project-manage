.approval-action-page { min-height: 100vh; background: #f3f4f6; padding-bottom: 40rpx; }

/* 卡片 */
.info-card, .comment-card, .history-card { background: #fff; margin: 16rpx 20rpx; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04); }
.card-title { font-size: 28rpx; font-weight: 600; color: #1f2937; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f3f4f6; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #fafafa; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 26rpx; color: #9ca3af; flex-shrink: 0; margin-right: 24rpx; }
.info-value { font-size: 26rpx; color: #1f2937; text-align: right; word-break: break-all; }
.info-value.tag { color: #6366f1; background: #eef2ff; padding: 4rpx 16rpx; border-radius: 6rpx; }

/* 业务详情链接 */
.detail-link-card { background: #fff; margin: 0 20rpx 16rpx; border-radius: 20rpx; padding: 24rpx 28rpx; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04); }
.detail-link { display: flex; justify-content: space-between; align-items: center; }
.link-text { font-size: 28rpx; color: #6366f1; font-weight: 500; }
.link-arrow { font-size: 32rpx; color: #6366f1; }

/* 审批意见 */
.comment-textarea { font-size: 28rpx; color: #1f2937; width: 100%; min-height: 120rpx; box-sizing: border-box; }

/* 审批按钮 */
.action-bar { display: flex; gap: 24rpx; margin: 24rpx 20rpx; }
.btn-reject, .btn-approve { flex: 1; font-size: 30rpx; font-weight: 600; border-radius: 14rpx; padding: 22rpx 0; border: none; }
.btn-reject { background: #fff; color: #ef4444; border: 1px solid #fecaca; }
.btn-approve { background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff; box-shadow: 0 4rpx 14rpx rgba(99,102,241,0.25); }

/* 无权限 */
.no-permission { margin: 24rpx 20rpx; text-align: center; }
.permission-text { font-size: 26rpx; color: #9ca3af; }

/* 历史 */
.history-loading, .history-empty { text-align: center; padding: 30rpx 0; }
.loading-text, .empty-text { font-size: 26rpx; color: #9ca3af; }
.timeline { padding-left: 20rpx; }
.timeline-item { display: flex; position: relative; padding-bottom: 24rpx; }
.timeline-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 10rpx; margin-right: 20rpx; flex-shrink: 0; position: relative; z-index: 1; }
.dot-approve { background: #16a34a; }
.dot-reject { background: #ef4444; }
.timeline-line { position: absolute; left: 7rpx; top: 30rpx; width: 2rpx; height: calc(100% - 6rpx); background: #e5e7eb; z-index: 0; }
.timeline-content { flex: 1; min-width: 0; }
.timeline-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.timeline-node { font-size: 28rpx; font-weight: 500; color: #1f2937; }
.timeline-result { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 6rpx; }
.text-approve { color: #16a34a; background: #dcfce7; }
.text-reject { color: #ef4444; background: #fecaca; }
.timeline-assignee, .timeline-comment { font-size: 24rpx; color: #6b7280; display: block; margin-bottom: 4rpx; }
.timeline-time { font-size: 22rpx; color: #9ca3af; display: block; }
