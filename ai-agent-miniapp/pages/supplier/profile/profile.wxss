.profile-page {
  min-height: 100vh;
  background: #f3f4f6;
  padding: 24rpx;
}

.profile-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
}

.loading-box, .empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.profile-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.profile-company { font-size: 34rpx; font-weight: 600; color: #1f2937; margin-bottom: 8rpx; }
.profile-status { font-size: 22rpx; color: #16a34a; background: #dcfce7; padding: 4rpx 16rpx; border-radius: 20rpx; }
.profile-title { font-size: 32rpx; font-weight: 600; color: #1f2937; }
.profile-hint { font-size: 24rpx; color: #9ca3af; margin-top: 6rpx; }

.info-list { display: flex; flex-direction: column; gap: 24rpx; margin-bottom: 32rpx; }

.info-item { display: flex; flex-direction: column; gap: 6rpx; }

.info-label { font-size: 24rpx; color: #9ca3af; }
.info-value { font-size: 28rpx; color: #1f2937; }

.edit-btn {
  background: #6366f1;
  color: #ffffff;
  border-radius: 10rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
}

.error-msg {
  background: #fef2f2;
  color: #dc2626;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.edit-form { display: flex; flex-direction: column; gap: 24rpx; margin-bottom: 32rpx; }

.form-group { display: flex; flex-direction: column; gap: 10rpx; }

.form-label { font-size: 28rpx; color: #1f2937; font-weight: 600; display: flex; align-items: center; }

.label-required { color: #ef4444; font-weight: 700; margin-right: 4rpx; font-size: 30rpx; }

.form-label-optional { color: #9ca3af; font-weight: 400; }

.form-input {
  border: 1rpx solid #d1d5db;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #f9fafb;
}

.edit-actions { display: flex; gap: 16rpx; }

.save-btn {
  flex: 1;
  background: #6366f1;
  color: #ffffff;
  border-radius: 10rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
}

.cancel-btn {
  flex: 1;
  background: #f3f4f6;
  color: #6b7280;
  border-radius: 10rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
}
