.checkin-page {
  padding: 24rpx;
  background: #f0f2f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 用户信息 */
.user-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #1890ff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 20rpx;
}
.user-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 今日打卡卡片 */
.today-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.today-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}
.today-body {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 24rpx;
}
.time-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.time-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.time-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}
.time-divider {
  width: 2rpx;
  height: 80rpx;
  background: #e8e8e8;
}
.today-status {
  text-align: center;
  font-size: 26rpx;
  color: #52c41a;
}

/* 打卡按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  margin-bottom: 40rpx;
}
.btn-clock-in,
.btn-clock-out {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}
.btn-clock-in {
  background: #1890ff;
  color: #fff;
}
.btn-clock-out {
  background: #52c41a;
  color: #fff;
}
.btn-clock-in[disabled],
.btn-clock-out[disabled] {
  background: #d9d9d9;
  color: #999;
}

/* 本月记录 */
.records-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.records-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}
.records-loading,
.records-empty {
  text-align: center;
  padding: 48rpx 0;
  color: #999;
  font-size: 26rpx;
}
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #666;
}
.record-item:last-child {
  border-bottom: none;
}
.record-date {
  flex: 1;
}
.record-in,
.record-out {
  flex: 1;
  text-align: center;
}
.record-status {
  width: 100rpx;
  text-align: right;
}
.status-in {
  color: #fa8c16;
}
.status-done {
  color: #52c41a;
}
