<view class="po-detail-page">
  <view wx:if="{{loading}}" class="state-box"><text class="state-text">加载中...</text></view>
  <view wx:elif="{{!record}}" class="state-box"><text class="state-text">记录不存在</text></view>
  <view wx:else>
    <!-- 头部 -->
    <view class="detail-card">
      <view class="card-head">
        <view class="head-icon">📦</view>
        <view class="head-info">
          <text class="head-title">{{record.purchaseRequestName || record.name || '采购记录'}}</text>
          <text class="head-sub">{{record.supplierName || '待填写供应商'}}</text>
        </view>
        <view class="head-status status-{{record.statusCode}}">{{statusLabel}}</view>
      </view>
      <view class="divider"></view>
      <view class="detail-grid">
        <view class="grid-item" wx:if="{{record.purchaseRequestCode || prInfo.code}}">
          <text class="grid-label">采购编号</text><text class="grid-value">{{record.purchaseRequestCode || prInfo.code || '-'}}</text>
        </view>
        <view class="grid-item" wx:if="{{prInfo}}">
          <text class="grid-label">规格</text><text class="grid-value">{{prInfo.specification || '-'}}</text>
        </view>
        <view class="grid-item" wx:if="{{prInfo.materialName}}">
          <text class="grid-label">物料</text><text class="grid-value">{{prInfo.materialName || '-'}}</text>
        </view>
        <view class="grid-item" wx:if="{{prInfo}}">
          <text class="grid-label">数量</text><text class="grid-value">{{prInfo.quantityStr || '-'}}</text>
        </view>
        <view class="grid-item">
          <text class="grid-label">供应商</text><text class="grid-value">{{record.supplierName || '待填写'}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.supplierPhone}}">
          <text class="grid-label">供应商电话</text><text class="grid-value">{{record.supplierPhone}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.unitPrice != null}}">
          <text class="grid-label">采购单价</text><text class="grid-value">¥{{record.unitPrice}}</text>
        </view>
        <view class="grid-item">
          <text class="grid-label">总金额</text><text class="grid-value">{{record.totalAmount != null ? '¥' + record.totalAmount : '-'}}</text>
        </view>
        <view class="grid-item">
          <text class="grid-label">采购日期</text><text class="grid-value">{{purchaseDateStr || '-'}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.expectedArrivalDate}}">
          <text class="grid-label">预计到货</text><text class="grid-value">{{record.expectedArrivalDate}}</text>
        </view>
        <view class="grid-item" wx:if="{{record.createdByName}}">
          <text class="grid-label">采购员</text><text class="grid-value">{{record.createdByName}}</text>
        </view>
        <view class="grid-item" wx:if="{{createdAtStr}}">
          <text class="grid-label">创建时间</text><text class="grid-value">{{createdAtStr}}</text>
        </view>
        <view class="grid-item full" wx:if="{{record.remark}}">
          <text class="grid-label">备注</text><text class="grid-value">{{record.remark}}</text>
        </view>
      </view>
    </view>

    <!-- 关联采购申请 -->
    <view class="detail-card" wx:if="{{prInfo}}">
      <text class="card-title">关联采购申请</text>
      <view class="pr-item">
        <text class="pr-code">{{prInfo.code || '-'}}</text>
        <text class="pr-name">{{prInfo.name}}</text>
        <text class="pr-meta">{{prInfo.quantityStr || ''}} · {{prInfo.arrivalDate || '-'}}</text>
      </view>
    </view>

    <!-- 附件 -->
    <view class="detail-card" wx:if="{{photoUrls.length > 0}}">
      <text class="card-title">附件</text>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photoUrls}}" wx:key="index" data-index="{{index}}" bindtap="handlePreviewPhoto">
          <image class="photo-thumb" src="{{item}}" mode="aspectFill" />
        </view>
      </view>
    </view>
  </view>
</view>
