.po-detail-page { min-height: 100vh; background: #f3f4f6; padding-bottom: 40rpx; }
.state-box { display: flex; justify-content: center; padding: 200rpx 0; } .state-text { font-size: 28rpx; color: #9ca3af; }
.detail-card { background: #fff; margin: 16rpx 20rpx; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04); }
.card-head { display: flex; align-items: center; } .head-icon { width: 80rpx; height: 80rpx; border-radius: 20rpx; background: #eef2ff; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-right: 20rpx; } .head-info { flex: 1; } .head-title { display: block; font-size: 32rpx; font-weight: 700; color: #1f2937; } .head-sub { display: block; font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }
.head-status { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 8rpx; } .status-0 { color: #d97706; background: #fef3c7; } .status-1 { color: #2563eb; background: #dbeafe; } .status-2 { color: #16a34a; background: #dcfce7; }
.divider { height: 1rpx; background: #f3f4f6; margin: 22rpx 0; }
.detail-grid { display: flex; flex-wrap: wrap; } .grid-item { width: 50%; padding: 12rpx 0; } .grid-item.full { width: 100%; } .grid-label { display: block; font-size: 22rpx; color: #9ca3af; margin-bottom: 4rpx; } .grid-value { font-size: 26rpx; color: #1f2937; }
.card-title { font-size: 28rpx; font-weight: 600; color: #1f2937; margin-bottom: 18rpx; }
.pr-list { } .pr-item { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 10rpx 0; border-bottom: 1rpx solid #f3f4f6; } .pr-item:last-child { border-bottom: none; } .pr-code { font-size: 24rpx; color: #6366f1; font-weight: 600; } .pr-name { font-size: 26rpx; color: #1f2937; } .pr-meta { font-size: 22rpx; color: #9ca3af; width: 100%; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 14rpx; } .photo-item { width: 210rpx; height: 210rpx; border-radius: 14rpx; overflow: hidden; } .photo-thumb { width: 100%; height: 100%; }
.action-bar { display: flex; flex-direction: column; gap: 16rpx; padding: 16rpx 20rpx; }
.btn-change { width: 100%; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff; font-size: 28rpx; font-weight: 600; border-radius: 14rpx; padding: 20rpx 0; border: none; box-shadow: 0 4rpx 14rpx rgba(99,102,241,0.25); }
.btn-edit { width: 100%; background: #fff; color: #6366f1; border: 1px solid #c7d2fe; font-size: 28rpx; border-radius: 14rpx; padding: 20rpx 0; }
.btn-inbound { width: 100%; background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: #fff; font-size: 28rpx; font-weight: 600; border-radius: 14rpx; padding: 20rpx 0; border: none; box-shadow: 0 4rpx 14rpx rgba(22,163,74,0.25); }
