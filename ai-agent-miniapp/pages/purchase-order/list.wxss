.po-list-page { min-height: 100vh; background: #f3f4f6; padding-bottom: 20rpx; }

/* Tab 切换 */
.tab-bar { display: flex; background: #fff; padding: 0 20rpx; border-bottom: 1rpx solid #f3f4f6; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #6b7280; position: relative; }
.tab-item.tab-active { color: #6366f1; font-weight: 600; }
.tab-item.tab-active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 6rpx; background: #6366f1; border-radius: 3rpx; }

/* 状态 */
.state-box { display: flex; flex-direction: column; align-items: center; padding: 180rpx 0; }
.state-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.state-text { font-size: 28rpx; color: #9ca3af; }

.items-list { padding: 16rpx 20rpx; }
.po-card { background: #fff; border-radius: 16rpx; margin-bottom: 16rpx; overflow: hidden; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04); }
.card-body { padding: 24rpx; }
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.card-name { font-size: 30rpx; font-weight: 600; color: #1f2937; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 12rpx; }
.card-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; flex-shrink: 0; }
.status-0 { color: #d97706; background: #fef3c7; }
.status-1 { color: #2563eb; background: #dbeafe; }
.status-2 { color: #16a34a; background: #dcfce7; }

.card-row { display: flex; align-items: center; margin-bottom: 6rpx; }
.card-label { font-size: 24rpx; color: #9ca3af; width: 80rpx; flex-shrink: 0; }
.card-value { font-size: 24rpx; color: #374151; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-amount { font-size: 26rpx; font-weight: 600; color: #1f2937; flex-shrink: 0; }

.card-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.card-date { font-size: 22rpx; color: #9ca3af; }
.card-actions { display: flex; gap: 12rpx; }

.btn-action { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 8rpx; line-height: 1.4; margin: 0; }
.btn-edit { color: #6366f1; background: #eef2ff; border: none; }
.btn-inbound { color: #16a34a; background: #dcfce7; border: none; }

.load-more { text-align: center; padding: 30rpx 0; font-size: 24rpx; color: #d1d5db; }
