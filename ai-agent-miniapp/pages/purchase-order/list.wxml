<view class="po-list-page">
  <view class="page-header"><text class="header-title">采购管理</text><text class="header-action" wx:if="{{canCreate}}" bindtap="handleCreate">+ 新建</text></view>
  <view class="filter-bar"><scroll-view scroll-x class="filter-scroll"><view class="filter-chips">
    <picker mode="selector" range="{{['全部状态','采购中','已采购','已到货']}}" value="{{statusIdx}}" bindchange="onStatusChange">
      <view class="chip {{statusIdx > 0 ? 'chip-active' : ''}}"><text>{{statusIdx === 0 ? '全部状态' : ['采购中','已采购','已到货'][statusIdx-1]}}</text><text class="chip-arrow">▾</text></view>
    </picker>
  </view></scroll-view></view>
  <view wx:if="{{loading && items.length === 0}}" class="state-box"><text class="state-text">加载中...</text></view>
  <view wx:elif="{{items.length === 0}}" class="state-box"><text class="state-icon">📦</text><text class="state-text">暂无采购记录</text></view>
  <view wx:else class="items-list">
    <view class="po-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="handleTap">
      <view class="card-body"><view class="card-top"><text class="card-name">{{item.prNames || '采购记录'}}</text><text class="card-status status-{{item.statusCode}}">{{item.statusLabel}}</text></view>
      <view class="card-mid"><text class="card-supplier">{{item.supplierName}}</text><text class="card-amount">¥{{item.totalAmount}}</text></view>
      <view class="card-prs" wx:if="{{item.prDetails}}"><text class="pr-detail" wx:for="{{item.prDetails}}" wx:key="id" wx:for-item="pr">{{pr.code}} {{pr.name}} · {{pr.quantityStr}}</text></view>
      <view class="card-bottom"><text class="card-date">{{item.purchaseDateStr}}</text><text class="card-arrow">查看 ›</text></view></view>
    </view>
    <view class="load-more"><text wx:if="{{loading}}">加载中...</text><text wx:elif="{{!hasMore}}">— 没有更多了 —</text></view>
  </view>
</view>
