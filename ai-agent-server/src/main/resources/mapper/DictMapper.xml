<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tx.aiagent.dict.infrastructure.DictMapper">

    <select id="selectByType" resultType="cn.tx.aiagent.dict.infrastructure.DictPO">
        SELECT id, type, code, label, sort, enabled
        FROM t_dict
        WHERE type = #{type}
        <if test="enabled != null">
            AND enabled = #{enabled}
        </if>
        ORDER BY sort ASC
    </select>

</mapper>
