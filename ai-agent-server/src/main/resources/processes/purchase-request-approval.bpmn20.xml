<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.flowable.org/processdef">

    <process id="purchase-request-approval" name="采购申请审批" isExecutable="true">

        <startEvent id="start" name="开始" />

        <userTask id="deptApproval" name="部门经理审批"
                  flowable:assignee="${deptManagerId}" />
        <exclusiveGateway id="gateway1" name="部门审批结果" />

        <userTask id="financeApproval" name="财务审批"
                  flowable:assignee="${financeManagerId}" />
        <exclusiveGateway id="gateway2" name="财务审批结果" />

        <userTask id="generalApproval" name="总经理审批"
                  flowable:assignee="${generalManagerId}" />
        <exclusiveGateway id="gateway3" name="总经理审批结果" />

        <endEvent id="approved" name="已通过" />
        <endEvent id="rejected" name="已驳回" />

        <sequenceFlow id="flow1" sourceRef="start" targetRef="deptApproval" />

        <sequenceFlow id="flow2" sourceRef="deptApproval" targetRef="gateway1" />
        <sequenceFlow id="flow3" sourceRef="gateway1" targetRef="financeApproval">
            <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'APPROVED'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow4" sourceRef="gateway1" targetRef="rejected">
            <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'REJECTED'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow5" sourceRef="financeApproval" targetRef="gateway2" />
        <sequenceFlow id="flow6" sourceRef="gateway2" targetRef="generalApproval">
            <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'APPROVED'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow7" sourceRef="gateway2" targetRef="deptApproval">
            <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'REJECTED'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow8" sourceRef="generalApproval" targetRef="gateway3" />
        <sequenceFlow id="flow9" sourceRef="gateway3" targetRef="approved">
            <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'APPROVED'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow10" sourceRef="gateway3" targetRef="financeApproval">
            <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'REJECTED'}</conditionExpression>
        </sequenceFlow>

    </process>

</definitions>
